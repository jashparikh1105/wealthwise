# ─────────────────────────────────────────────────────────────────────────────
# Wealthwise settings. Locally, nothing here is required (npm run dev just works).
# On Vercel: Project → Settings → Environment Variables. Only DATABASE_URL is required.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED on Vercel — Supabase → your project → Connect → "Transaction pooler" URI,
# with [YOUR-PASSWORD] replaced by your database password. Example:
# postgresql://postgres.abcdefghijkl:MyPassword123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Recommended — shown on the privacy page as the grievance/support contact
SUPPORT_EMAIL=

# Recommended (free) — send password-reset, welcome and weekly/monthly summary emails from a Gmail account.
# Turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional (paid per use) — switch AI features from the free built-in engine to Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Max Claude calls per day across all users (protects your bill); default 1500
AI_DAILY_LIMIT=1500
# Max Ask Wealthwise questions per user per day; default 30
CHAT_DAILY_CAP=30
# Model overrides (defaults shown)
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# Optional — Google sign-in (console.cloud.google.com → Credentials → OAuth client ID, type "Web application",
# redirect URI: https://YOUR-APP.vercel.app/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — usually NOT needed:
# APP_URL=https://your-domain.com     (auto-detected on Vercel)
# AUTH_SECRET=...                     (auto-generated and stored in the database if empty)
# CRON_SECRET=...                     (without it, only Vercel's own scheduler may call /api/cron/*)
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY (push notifications; auto-generated and stored in the database if empty)
# SEED_DEMO=false                     (skip the shared demo account)
# RESEND_API_KEY / SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (alternatives to Gmail)
